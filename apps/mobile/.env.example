# Copiar como .env.local dentro de apps/mobile. No subir secretos reales.
# Para Supabase local, obtener URL y anon key con `npx supabase status` desde backend/supabase.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-local-anon-key

# La app deriva la URL de sync como $EXPO_PUBLIC_SUPABASE_URL/functions/v1/sync.
# En un dispositivo físico, 127.0.0.1 apunta al teléfono: usar una URL accesible
# por el dispositivo (por ejemplo, Supabase alojado o un túnel de desarrollo).
