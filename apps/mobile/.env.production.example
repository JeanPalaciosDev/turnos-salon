# Plantilla de producción: se puede versionar porque no contiene valores reales.
# Configura estas mismas variables en el entorno "production" de EAS o de tu CI
# antes de generar un build. No guardes valores de producción en este repositorio.
# EXPO_PUBLIC_* se incorpora al bundle: nunca coloques aquí una service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-production-anon-or-publishable-key

# La anon/publishable key es pública por diseño; la protección de datos depende de
# las políticas RLS y las RPC de Supabase, no de ocultar esa clave.
