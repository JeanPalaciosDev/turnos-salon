# Valores para desarrollo local. No guardar secretos reales en este archivo.
# Después de ejecutar `supabase start`, obtener estos valores con `supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-local-anon-key

# Solo para Edge Functions que requieran privilegios de administración.
# No exponer este valor en apps/mobile ni commitear un valor real.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-local-service-role-key
